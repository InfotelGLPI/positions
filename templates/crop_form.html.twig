{% import 'components/form/fields_macros.html.twig' as fields %}

{# Creation of a sub-area cropped from the map of a location (Position::showMapCreateLocation()),
   driven by public/positions_crop.js (Cropper.js) #}

<form method="post" action="{{ form_url }}" id="positions_crop_form"
      data-empty-area-message="{{ empty_area_message }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    {% for coord in ['x1', 'y1', 'x2', 'y2', 'w', 'h'] %}
        <input type="hidden" name="{{ coord }}" id="{{ coord }}" class="positions-crop-coords" value="">
    {% endfor %}
    <input type="hidden" name="document_id" value="{{ document_id }}">
    <input type="hidden" name="extension" value="{{ extension }}">
    <input type="hidden" name="locations_idParent" value="{{ locations_idParent }}">
    <input type="hidden" name="entities_id" value="{{ entities_id }}">

    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-crop"></i>
            <strong>{{ __('Creation of sub-areas on the map', 'positions') }}</strong>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-check form-check-inline">
                    <input type="radio" class="form-check-input" name="test" value="newLocation" checked>
                    <span class="form-check-label">{{ __('Create a new location', 'positions') }}</span>
                </label>
                <label class="form-check form-check-inline">
                    <input type="radio" class="form-check-input" name="test" value="existLocation">
                    <span class="form-check-label">{{ __('Choose an existing location', 'positions') }}</span>
                </label>
            </div>

            <div data-positions-choice="newLocation">
                {{ fields.textField('name', '', __('Name')) }}
            </div>
            <div data-positions-choice="existLocation" class="d-none">
                {% if sub_locations is not empty %}
                    {{ fields.dropdownField('Location', 'locations_id', locations_idParent, __('Location'), {
                        'entity': session('glpiactive_entity'),
                        'condition': {'glpi_locations.id': sub_locations},
                    }) }}
                {% else %}
                    <div class="alert alert-info mb-0">{{ __('No sub-area found', 'positions') }}</div>
                {% endif %}
            </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-center gap-3">
            <label class="form-check mb-0">
                <input type="checkbox" class="form-check-input" name="continueAdd" value="on">
                <span class="form-check-label">{{ __('Add and continue', 'positions') }}</span>
            </label>
            <button type="submit" name="valid" value="1" class="btn btn-primary">
                <i class="ti ti-plus me-1"></i>{{ _x('button', 'Add') }}
            </button>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-map-2"></i>
            <strong>{{ document_name }}</strong>
            <span class="text-muted ms-2">{{ __('Select an area and click on OK', 'positions') }}</span>
        </div>
        <div class="card-body overflow-auto" id="imageCrop">
            <img src="{{ img_url }}" id="target" alt="" width="{{ width }}" height="{{ height }}">
        </div>
    </div>
</form>
