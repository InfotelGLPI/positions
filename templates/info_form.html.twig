{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{# Fields displayed in the information window of an item type on the map (Info::showForm()) #}

{% block form_fields %}
    {{ fields.textField('name', item.fields['name'], __('Name')) }}
    {{ fields.dropdownYesNo('is_active', item.fields['is_active'], __('Active')) }}
    {{ fields.htmlField('itemtype', itemtype_field, __('Equipment', 'positions')) }}
    {# Reloaded by ajax/dropdownInfoFields.php when another item type is chosen #}
    {{ fields.ajaxField('span_fields', criterias_field, __('Displayed fields', 'positions')) }}
    {{ fields.textareaField('comment', item.fields['comment'], __('Comments')) }}
{% endblock %}
