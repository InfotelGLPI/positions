{# Types of items shown on the map (Position::getSelectDisplay()) #}

<form method="post" name="massiveaction_form" id="massiveaction_form" action="{{ form_url }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="card h-100">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-filter"></i>
            <strong>{{ __('Limited view', 'positions') }}</strong>
        </div>
        <div class="card-body">
            {% for type in types %}
                <label class="form-check form-check-inline">
                    <input type="checkbox" class="form-check-input" name="itemtype[]" value="{{ type.class }}"{{ type.checked ? ' checked' : '' }}>
                    <span class="form-check-label">{{ type.name }}</span>
                </label>
            {% endfor %}
        </div>
        <div class="card-footer text-center">
            <button type="submit" name="affich" value="1" class="btn btn-primary">
                <i class="ti ti-eye me-1"></i>{{ _x('button', 'Post') }}
            </button>
        </div>
    </div>
</form>
