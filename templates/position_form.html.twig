{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{# Position of an item on the map of a location (Position::showForm()) #}

{% block form_fields %}
    {{ fields.textField('name', item.fields['name'], __('Name')) }}
    {{ fields.htmlField('items_id', item_field, __('Associated element', 'positions')) }}
    {% if show_coordinates %}
        {{ fields.numberField('x_coordinates', item.fields['x_coordinates'], __('Coordinate x', 'positions'), {'step': 1}) }}
        {{ fields.numberField('y_coordinates', item.fields['y_coordinates'], __('Coordinate y', 'positions'), {'step': 1}) }}
    {% endif %}
{% endblock %}
