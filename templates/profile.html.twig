{# Rights of the plugin in the Profile tab (Profile::showForm()) #}

<div class="firstbloc">
    {% if canedit and openform %}
    <form method="post" action="{{ 'Profile'|itemtype_form_path }}">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    {% endif %}

    {% do profile.displayRightsChoiceMatrix(rights, {
        'canedit': canedit,
        'default_class': 'tab_bg_2',
        'title': __('General'),
    }) %}

    {% if canedit and closeform %}
        <div class="text-center mt-2">
            <input type="hidden" name="id" value="{{ profiles_id }}">
            <button type="submit" name="update" value="1" class="btn btn-primary">
                <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
            </button>
        </div>
    {% endif %}

    {% if canedit and closeform %}
    </form>
    {% endif %}
</div>
