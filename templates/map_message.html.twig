{# Warning shown instead of a map (Position::displayMapMessage()) #}

<div class="alert alert-warning d-flex align-items-center gap-2">
    <i class="ti ti-alert-triangle"></i>
    <div>
        {{ message }}
        {% if back_link %}
            <div class="mt-2">
                {% set back_id = 'positions_back' ~ random() %}
                <button type="button" id="{{ back_id }}" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i>{{ __('Back') }}
                </button>
                {# Formerly a javascript: URL, blocked by the Content Security Policy #}
                <script>
                    document.getElementById('{{ back_id }}').addEventListener('click', () => {
                        history.back();
                    });
                </script>
            </div>
        {% endif %}
    </div>
</div>
