{% import 'components/form/fields_macros.html.twig' as fields %}

{# Tab "Cartographies" of an item without position: creation of its position (Position::showAddFromItem()) #}

<form method="post" action="{{ form_url }}" name="pointform" id="pointform">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="ti ti-map-pin-plus"></i>
            <strong>{{ __('Create coordinates', 'positions') }}</strong>
        </div>
        <div class="card-body">
            {{ fields.textField('name', name, __('Name')) }}
            {% if locations_id %}
                {{ fields.hiddenField('locations_id', locations_id) }}
                {{ fields.htmlField('location', location_name|e, __('Location')) }}
            {% else %}
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-0">
                    <i class="ti ti-alert-triangle"></i>
                    <span>{{ __('No location selected', 'positions') }}</span>
                </div>
            {% endif %}
        </div>
        {% if canupdate %}
            <div class="card-footer text-center">
                {{ fields.hiddenField('items_id', items_id) }}
                {{ fields.hiddenField('itemtype', itemtype) }}
                {{ fields.hiddenField('entities_id', entities_id) }}
                <button type="submit" name="additem" value="1" class="btn btn-primary">
                    <i class="ti ti-plus me-1"></i>{{ _x('button', 'Post') }}
                </button>
            </div>
        {% endif %}
    </div>
</form>
